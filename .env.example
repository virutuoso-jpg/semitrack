# === 한국투자증권(KIS) Open API ===
# KIS Developers 포털에서 발급받은 값 (모의투자로 먼저 테스트 추천)
KIS_APP_KEY=여기에_앱키_입력
KIS_APP_SECRET=여기에_앱시크릿_입력
KIS_ACCOUNT_NO=계좌번호_앞8자리
KIS_ACCOUNT_PRODUCT_CD=01
# prod: 실전투자, vps: 모의투자
KIS_ENV=vps

# === DART(전자공시) Open API ===
# https://opendart.fss.or.kr 에서 무료 발급
DART_API_KEY=여기에_DART_API_KEY_입력

# === KRX 데이터마켓(data.krx.co.kr) 계정 ===
# 투자자별(사모펀드/금융투자/연기금 등) 세부 매매동향 조회에 필요 (무료 가입)
KRX_ID=가입한_아이디
KRX_PW=가입한_비밀번호

# === 관세청 오픈API(data.go.kr) ===
# https://www.data.go.kr 회원가입 후 "관세청_품목별 국가별 수출입실적(GW)" 활용신청
CUSTOMS_API_KEY=여기에_공공데이터포털_서비스키_입력

# === 추적 대상 종목 ===
TICKER_SAMSUNG=005930
TICKER_SKHYNIX=000660
